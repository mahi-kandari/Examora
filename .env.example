FIREBASE_CREDENTIALS=/path/to/service-account.json
SCHEDULER_INTERVAL_MINUTES=15
# Optional. Enables traffic-aware departure times when the user shares location.
GOOGLE_MAPS_API_KEY=
# Set this to a writable path in containers, e.g. /tmp/examora-eta_cache.json.
CHRONOS_CACHE_PATH=/tmp/examora-eta_cache.json
